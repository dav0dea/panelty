{
	"name": "panelty",
	"version": "0.1.0",
	"description": "A tab + panel workspace for Svelte: split, drag, tear off, and hand every gesture to a host you own.",
	"license": "MIT",
	"type": "module",
	"files": [
		"src",
		"README.md"
	],
	"exports": {
		".": {
