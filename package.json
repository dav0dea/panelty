{
	"name": "panelty",
	"version": "0.2.0",
	"description": "A panel workspace for Svelte: split, tab, drag, and hand every gesture to a host you own.",
	"license": "MIT",
	"author": "Philipp Thölke",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/dav0dea/panelty.git"
	},
	"keywords": [
		"svelte",
		"svelte5",
		"panels",
		"tabs",
		"layout",
		"dockable",
		"workspace",
		"split-pane"
	],
	"type": "module",
	"files": [
		"src",
		"!src/**/*.test.ts"
	],
	"exports": {
		".": {
			"types": "./src/lib/index.ts",
			"svelte": "./src/lib/index.ts",
			"default": "./src/lib/index.ts"
		},
		"./tokens.css": "./src/lib/ui/tokens.css"
	},
	"svelte": "./src/lib/index.ts",
	"sideEffects": [
		"**/*.css"
	],
	"scripts": {
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run",
		"prepublishOnly": "npm run check && npm test"
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@sveltejs/vite-plugin-svelte": "^4.0.0",
		"@types/node": "^25.9.1",
		"svelte": "^5.1.0",
		"svelte-check": "^4.0.5",
		"typescript": "^5.6.3",
		"vite": "^5.4.10",
		"vitest": "^4.1.7"
	}
}
