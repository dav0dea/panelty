	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@sveltejs/vite-plugin-svelte": "^4.0.0",
		"@types/node": "^25.9.1",
		"svelte": "^5.1.0",
		"svelte-check": "^4.0.5",
		"typescript": "^5.6.3",
		"vite": "^5.4.10",
		"vitest": "^4.1.7"
	}
